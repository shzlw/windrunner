# Copy to .env next to docker-compose.yml and adjust before `docker compose up`.
# All values have defaults; this file exists so secrets are not committed.

# Postgres credentials used by both the database and the app.
POSTGRES_USER=windrunner
POSTGRES_PASSWORD=windrunner

# Port the app is exposed on (host side).
APP_PORT=8066

# Bootstrap superadmin, only created on first start when no users exist.
WINDRUNNER_BOOTSTRAP_SUPERADMIN_USERNAME=admin
WINDRUNNER_BOOTSTRAP_SUPERADMIN_EMAIL=admin@localhost
WINDRUNNER_BOOTSTRAP_SUPERADMIN_PASSWORD=changeme

# Set to true once you serve the app over HTTPS behind a reverse proxy;
# login cookies are marked Secure and will not work over plain HTTP otherwise.
WINDRUNNER_AUTH_COOKIE_SECURE=false

# Optional: AI features (bring your own key).
# Leave the provider as none to disable AI.
WINDRUNNER_LLM_PROVIDER=none  # none | openai | openrouter | gemini | claude
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=provider/model
# OPENROUTER_SITE_URL=https://your-site.example  # Optional attribution header.
# OPENROUTER_SITE_NAME=Windrunner                  # Optional attribution header.
# Set this to true to enable the voice dictation button in chat.
# WINDRUNNER_AUDIO_TRANSCRIPTION_ENABLED=false
# WINDRUNNER_AUDIO_TRANSCRIPTION_PROVIDER=openai
# OPENAI_TRANSCRIPTION_API_KEY=  # Optional; falls back to OPENAI_API_KEY.
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# WINDRUNNER_AUDIO_TRANSCRIPTION_MAX_DURATION_SECONDS=120
# WINDRUNNER_AUDIO_TRANSCRIPTION_MAX_FILE_SIZE_BYTES=10485760
# WINDRUNNER_AUDIO_TRANSCRIPTION_CONNECT_TIMEOUT=10s
# WINDRUNNER_AUDIO_TRANSCRIPTION_READ_TIMEOUT=2m
# GEMINI_TRANSCRIPTION_API_KEY=  # Optional; falls back to GEMINI_API_KEY.
# GEMINI_TRANSCRIPTION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
# WINDRUNNER_UPLOAD_TEMP_DIR=/tmp
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
