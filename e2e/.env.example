# Copy to .env.local (git-ignored) and fill in.

# Server under test
WINDRUNNER_BASE_URL=http://localhost:8066

# --- Auth mode 1: pre-existing API key (skips login entirely) ---
# Create a key in the app under Account -> API keys with all external API
# scopes when running the full external API suite.
# E2E_API_KEY=wr_k_...
# Only needed by tests that create owned resources:
# E2E_USER_ID=user_...
# Needed for project/team membership mutation coverage with a pre-existing key:
# E2E_SECOND_USER_ID=user_...
# Needed for admin-only team and audit-log tests with a pre-existing key:
# E2E_GLOBAL_ROLE=ADMIN

# --- Auth mode 2: session login (a scoped key is minted per test) ---
# E2E_LOGIN=admin
# E2E_PASSWORD=changeme
