{
  "name": "@shzlwio/windrunner-cli",
  "version": "1.1.0",
  "description": "Command-line interface for Windrunner.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "windrunner": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
