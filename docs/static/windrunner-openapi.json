{
  "openapi": "3.1.0",
  "info": {
    "title": "Windrunner API",
    "description": "API-key authenticated endpoints for Windrunner integrations.\n\nSend the key as `Authorization: Bearer <key>`. Each operation\nrequires the scope named in the API reference. Project-scoped\nreads and writes also require the key owner to have access to\nthat project. Team and team-project directory endpoints are\norganization-wide; audit-log endpoints require an admin or\nsuperadmin API-key owner.\n\nCollection endpoints use zero-based `page` and `size` parameters.\nThe maximum page size is 100 and pagination metadata is returned\nin the standard `meta` response object. Search responses are\nbounded by their `limit` parameter (maximum 100).\n",
    "version": "v1"
  },
  "security": [
    {
      "ApiKeyBearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Teams",
      "description": "Create teams, manage members and linked projects."
    },
    {
      "name": "Users",
      "description": "Resolve limited user identity information."
    },
    {
      "name": "Projects",
      "description": "Create projects, manage members and linked teams."
    },
    {
      "name": "Project content",
      "description": "Search project content and manage content order."
    },
    {
      "name": "Relationships",
      "description": "Create and manage work item relationships."
    },
    {
      "name": "Entries",
      "description": "Create and manage work item entries."
    },
    {
      "name": "Work items",
      "description": "Create and manage work items."
    },
    {
      "name": "Audit log",
      "description": "Read audit log entries."
    }
  ],
