  "components": {
    "schemas": {
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "A single error reported for a request.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message."
          },
          "field": {
            "type": "string",
            "description": "Request field the error relates to, when applicable."
          },
          "details": {
            "type": "object",
            "additionalProperties": {},
            "description": "Additional structured details for this error."
          }
        }
      },
      "ApiMeta": {
        "type": "object",
        "description": "Request metadata. Pagination fields are present only on paginated responses.",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Server-generated request identifier, useful for support."
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "Current page number, zero-based."
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Page size used for this response."
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of items across all pages."
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "description": "Total number of pages."
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "description": "Standard response envelope for all Windrunner API endpoints.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/UserResponse",
            "description": "The requested resource. Null when errors is non-empty."
          },
          "errors": {
            "type": "array",
            "description": "Errors reported for this request. Empty on success.",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta",
            "description": "Request metadata. Present on paginated responses."
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "globalRole": {
            "type": "string"
          },
          "mustChangePassword": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "memberUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
